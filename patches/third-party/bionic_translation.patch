diff --git a/linker/linker.c b/linker/linker.c
index 7824cc1..b03c9c6 100644
--- a/linker/linker.c
+++ b/linker/linker.c
@@ -80,11 +80,14 @@
 #include "linker_sleb128.h"
 
 #define ALLOW_SYMBOLS_FROM_MAIN 1
