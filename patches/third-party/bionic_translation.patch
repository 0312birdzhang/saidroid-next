+/* ---- 护栏页模式（SD_ALLOC_GUARD=1）：越界写立即 SIGSEGV ----
+ *
+ * 布局：mmap(data_pages + 1) ，最后一页 mprotect(PROT_NONE) 作护栏；
+ * 用户块紧贴护栏页前，尽量让块尾落在页边界上（不足 16 字节的对齐差额用 canary 覆盖）。
+ * 记帐全部放在链表里而不是块头，因此越界写碰不到任何簿记信息——
+ * 这一点很关键：旧实现把块头压在块尾，越界写会抹掉 magic，free 就退化成
+ * glibc 的 "free(): invalid pointer"，把 SIGSEGV 这条线索丢掉。
+ *
+ * canary：块尾到页尾之间填 0xAB，free 时校验；1..15 字节的越界由它兜住，
+ * >=16 字节的越界由护栏页当场 SIGSEGV。
+ */
+static int sd_guard_state = -1;
+static int sd_guard_on(void) {
+	if (sd_guard_state < 0) {
+		const char *e = getenv("SD_ALLOC_GUARD");
+		sd_guard_state = (e && *e == '1') ? 1 : 0;
+	}
+	return sd_guard_state;
+}
+
+#define SD_G_CANARY 0xAB
+#define SD_G_SLOTS  (1u << 18)          /* 26 万条，够 bootstrap 阶段用 */
+#define SD_G_MAXLIVE 200000
+typedef struct sd_grec {
+	void *user;
+	void *base;
+	size_t maplen;
+	size_t user_size;
+	size_t pad_end;                     /* user+size 到页尾的 canary 长度 */
+	struct sd_grec *next;
+} sd_grec_t;
+
+static sd_grec_t *sd_gtab[SD_G_SLOTS];
+static size_t sd_glive = 0;
+static int sd_gtab_failed = 0;
+
+static size_t sd_ghash(void *p) {
+	uintptr_t x = (uintptr_t)p;
+	x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 29;
+	return (size_t)(x & (SD_G_SLOTS - 1));
+}
+static void sd_g_insert(sd_grec_t *r) {
+	size_t i = sd_ghash(r->user);
+	r->next = sd_gtab[i];
+	sd_gtab[i] = r;
+	sd_glive++;
+}
+static sd_grec_t *sd_g_find(void *user) {
+	for (sd_grec_t *r = sd_gtab[sd_ghash(user)]; r; r = r->next)
+		if (r->user == user) return r;
+	return NULL;
+}
+static void sd_g_remove(sd_grec_t *r) {
+	sd_grec_t **pp = &sd_gtab[sd_ghash(r->user)];
+	while (*pp) { if (*pp == r) { *pp = r->next; sd_glive--; return; } pp = &(*pp)->next; }
+}
