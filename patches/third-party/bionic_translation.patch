+/* ===== SDUNIFIED_ALLOC =====
+ * 统一 bionic 世界的分配器入口。
+ * 所有 bionic 库都把 libc.so 映射到本库，因此它们的 malloc/free 家族都会落到这里，
+ * 与 ART（glibc 侧）共用同一个 glibc 堆，避免"一边分配、另一边释放"的语义分裂。
+ * 内部一律走 glibc 的 __libc_*，避免自递归。 */
+extern void *__libc_malloc(size_t);
+extern void  __libc_free(void *);
+extern void *__libc_calloc(size_t, size_t);
+extern void *__libc_realloc(void *, size_t);
