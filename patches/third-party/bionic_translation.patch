+static void *sd_g_alloc(size_t n, size_t align) {
+	if (sd_glive >= SD_G_MAXLIVE) return NULL;         /* 超出上限就退回普通 malloc */
+	if (align < 16) align = 16;
+	if (align & (align - 1)) align = 16;               /* 非 2 的幂：不接受 */
+	size_t need = n ? n : 1;
+	/* 多留一个 align 的余量，保证对齐后块尾仍能贴住页边界 */
+	size_t datapages = (need + align + PAGESIZE - 1) & ~(size_t)(PAGESIZE - 1);
+	size_t maplen = datapages + PAGESIZE;
+	char *base = mmap(NULL, maplen, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (base == MAP_FAILED) return NULL;
+	if (mprotect(base + datapages, PAGESIZE, PROT_NONE) != 0) { munmap(base, maplen); return NULL; }
+	uintptr_t end = (uintptr_t)(base + datapages);
+	uintptr_t u = (end - need) & ~(uintptr_t)(align - 1);
+	if (u < (uintptr_t)(base + 16)) u = (uintptr_t)(base + 16);
+	size_t pad = (size_t)(end - (u + need));
+	if (pad) memset((void *)(u + need), SD_G_CANARY, pad);
+	sd_grec_t *r = (sd_grec_t *)__libc_malloc(sizeof(sd_grec_t));
+	if (!r) { munmap(base, maplen); return NULL; }
+	r->user = (void *)u; r->base = base; r->maplen = maplen;
+	r->user_size = need; r->pad_end = pad; r->next = NULL;
+	sd_g_insert(r);
+	return (void *)u;
+}
+
+/* 返回 1 表示这个指针是护栏块并且已经处理完 */
+static int sd_g_free(void *ptr) {
+	sd_grec_t *r = sd_g_find(ptr);
+	if (!r) return 0;
+	if (r->pad_end) {
+		unsigned char *c = (unsigned char *)r->user + r->user_size;
+		for (size_t i = 0; i < r->pad_end; ++i) {
+			if (c[i] != SD_G_CANARY) {
+				char msg[192];
+				snprintf(msg, sizeof(msg),
+					"SD_GUARD: heap overrun on %p (size=%zu, pad=%zu, first bad byte +%zu)",
+					r->user, r->user_size, r->pad_end, i);
+				sd_bt(msg, ptr);
+				break;
+			}
+		}
+	}
+	sd_g_remove(r);
+	munmap(r->base, r->maplen);
+	__libc_free(r);
+	return 1;
+}
+
+void *malloc(size_t size) {
+	if (sd_guard_on()) { void *g = sd_g_alloc(size, 16); if (g) return g; }
+	void *p = __libc_malloc(size);
+	if (sd_trace_on()) sd_tab_add(p);
+	return p;
+}
+void free(void *ptr) {
+	if (ptr && sd_guard_on() && sd_g_free(ptr)) return;
+	if (ptr && sd_guard_on() && !sd_gtab_failed) {
+		/* 护栏模式下释放了非护栏指针：要么来自 glibc（合法，交下去），
+		 * 要么是野指针/别名越界，这里报警以便定位。 */
+		char msg[160];
+		snprintf(msg, sizeof(msg), "SD_GUARD: free of NON-guard pointer %p", ptr);
+		sd_bt(msg, ptr);
+	}
+	if (ptr && sd_trace_on() && !sd_tab_del(ptr)) {
+		static const char msg[] = "SD_ALLOC_TRACE: free of untracked pointer\n";
+		write(2, msg, sizeof(msg) - 1);
+		static int in_bt = 0;
+		if (!in_bt) {
+			void *bt[24]; in_bt = 1;
+			int n = backtrace(bt, 24);
+			backtrace_symbols_fd(bt, n, 2);
+			in_bt = 0;
+		}
+	}
+	__libc_free(ptr);
+}
+void *calloc(size_t n, size_t size) {
+	size_t total = n * size;
+	if (sd_guard_on() && size && total / size == n) {
+		void *g = sd_g_alloc(total, 16);
+		if (g) return g;      /* mmap 出来的页天然是 0 */
+	}
+	void *p = __libc_calloc(n, size);
+	if (sd_trace_on()) sd_tab_add(p);
+	return p;
+}
+void *realloc(void *ptr, size_t size) {
+	if (sd_guard_on() && ptr) {
+		sd_grec_t *r = sd_g_find(ptr);
+		if (r) {
+			if (!size) { sd_g_free(ptr); return NULL; }
+			void *np = sd_g_alloc(size, 16);
+			if (!np) return NULL;
+			size_t copy = r->user_size < size ? r->user_size : size;
+			memcpy(np, ptr, copy);
+			sd_g_free(ptr);
+			return np;
+		}
+	}
+	if (ptr && sd_trace_on()) sd_tab_del(ptr);
+	void *p = __libc_realloc(ptr, size);
+	if (sd_trace_on()) sd_tab_add(p);
+	return p;
+}
+void *memalign(size_t align, size_t size) {
+	if (sd_guard_on()) { void *g = sd_g_alloc(size, align); if (g) return g; }
+	return __libc_memalign(align, size);
+}
+void *valloc(size_t size) {
+	if (sd_guard_on()) { void *g = sd_g_alloc(size, PAGESIZE); if (g) return g; }
+	return __libc_memalign(PAGESIZE, size);
+}
+
+int posix_memalign(void **memptr, size_t align, size_t size)
+{
+	if (sd_guard_on()) {
+		void *g = sd_g_alloc(size, align);
+		if (g) { *memptr = g; return 0; }
+	}
+	void *p = __libc_memalign(align, size);
+	if (!p) return 12; /* ENOMEM */
+	*memptr = p;
+	return 0;
+}
+
+void *aligned_alloc(size_t align, size_t size)
+{
+	if (sd_guard_on()) { void *g = sd_g_alloc(size, align); if (g) return g; }
+	return __libc_memalign(align, size);
+}
+
+size_t malloc_usable_size(void *ptr)
+{
+	if (ptr && sd_guard_on()) {
+		sd_grec_t *r = sd_g_find(ptr);
+		if (r) return r->user_size;
+	}
+	/* glibc 只导出 malloc_usable_size；用 dlsym 取真正的实现避免自引用 */
+	typedef size_t (*fn_t)(void *);
+	static fn_t real_fn;
+	if (!real_fn) real_fn = (fn_t)dlsym(RTLD_NEXT, "malloc_usable_size");
+	return real_fn ? real_fn(ptr) : 0;
+}
diff --git a/libc/props.c b/libc/props.c
new file mode 100644
index 0000000..de502f4
--- /dev/null
+++ b/libc/props.c
@@ -0,0 +1,365 @@
+/* Android 系统属性存储。
+ *
+ * 原来这里是硬编码桩：ANDROID_ROOT 写死 /system、属性一律返回空串。
+ * 结果 android.os.Build 的静态初始化拿不到 ro.product.cpu.abilist 之类的值，
+ * getStringList() 返回 new String[0]，后续索引 [0] 直接
+ * ArrayIndexOutOfBoundsException，Resources 构造就崩了。
+ *
+ * 这里实现一个真的属性表：
+ *   1. 若设了 SD_BUILD_PROP，读那个文件；
+ *   2. 否则读 $ANDROID_ROOT/build.prop；
+ *   3. 剩下的关键项用内置默认值补齐（设备上没有 build.prop 时也能起来）。
+ *
+ * 同一份实现同时导出 __system_property_* 和 bionic___system_property_* 两套名字：
+ * bionic 链接器解析符号时优先找 "bionic_" 前缀版本，普通名字留给直接引用的人。
+ */
+#define _GNU_SOURCE
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#define SD_PROP_NAME_MAX  32
+#define SD_PROP_VALUE_MAX 92
+#define SD_PROP_BUCKETS   127
+
+/* 对外当句柄用，调用方只会把它再传回来，不会解引用内部布局 */
+struct prop_info {
+	const char *name;
+	const char *value;
+	unsigned serial;
+};
+
+struct sd_prop {
+	struct sd_prop *next;
+	struct prop_info info;
+	char name[SD_PROP_NAME_MAX];
+	char value[SD_PROP_VALUE_MAX];
+};
+
+static struct sd_prop *sd_props[SD_PROP_BUCKETS];
+static int sd_props_ready = 0;
+static unsigned sd_props_serial = 1;
+
+static unsigned sd_prop_hash(const char *s)
+{
+	unsigned h = 5381u;
+	while (*s) {
+		h = h * 33u + (unsigned char)*s++;
+	}
+	return h % SD_PROP_BUCKETS;
+}
+
+static struct sd_prop *sd_prop_entry(const char *name)
+{
+	struct sd_prop *p;
+	if (!name || !*name) {
+		return NULL;
+	}
+	for (p = sd_props[sd_prop_hash(name)]; p; p = p->next) {
+		if (!strcmp(p->name, name)) {
+			return p;
+		}
+	}
+	return NULL;
+}
+
+static int sd_prop_put(const char *name, const char *value)
+{
+	struct sd_prop *p;
+
+	if (!name || !*name || strlen(name) >= SD_PROP_NAME_MAX) {
+		return -1;
+	}
+	p = sd_prop_entry(name);
+	if (!p) {
+		p = calloc(1, sizeof(*p));
+		if (!p) {
+			return -1;
+		}
+		snprintf(p->name, sizeof(p->name), "%s", name);
+		p->info.name = p->name;
+		p->info.value = p->value;
+		unsigned h = sd_prop_hash(name);
+		p->next = sd_props[h];
+		sd_props[h] = p;
+	}
+	snprintf(p->value, sizeof(p->value), "%s", value ? value : "");
+	p->info.serial = sd_props_serial++;
+	return 0;
+}
+
+/* 只在不存在时写入：给内置默认值用，避免覆盖 build.prop 里的真值 */
+static void sd_prop_default(const char *name, const char *value)
+{
+	if (!sd_prop_entry(name)) {
+		sd_prop_put(name, value);
+	}
+}
+
+static void sd_prop_trim(char *s)
+{
+	size_t n;
+	while (*s == ' ' || *s == '\t') {
+		memmove(s, s + 1, strlen(s));
+	}
+	n = strlen(s);
+	while (n && (s[n - 1] == '\n' || s[n - 1] == '\r' ||
+	             s[n - 1] == ' ' || s[n - 1] == '\t')) {
+		s[--n] = 0;
+	}
+}
+
+static void sd_props_load_file(const char *path)
+{
+	FILE *f;
+	char line[512];
+
+	if (!path || !*path) {
+		return;
+	}
+	f = fopen(path, "r");
+	if (!f) {
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		char *s = line;
+		char *eq;
+		while (*s == ' ' || *s == '\t') {
+			s++;
+		}
+		if (*s == '#' || *s == '=' || !*s || *s == '\n' || *s == '\r') {
+			continue;
+		}
+		eq = strchr(s, '=');
+		if (!eq) {
+			continue;
+		}
+		*eq = 0;
+		sd_prop_trim(s);
+		sd_prop_trim(eq + 1);
+		if (*s) {
+			sd_prop_put(s, eq + 1);
+		}
+	}
+	fclose(f);
+}
+
+static void sd_props_init(void)
+{
+	const char *file;
+	const char *root;
+	char path[PATH_MAX];
+
+	if (sd_props_ready) {
+		return;
+	}
+	sd_props_ready = 1;   /* 先置位，防止重入时无限递归 */
+
+	file = getenv("SD_BUILD_PROP");
+	if (file && *file) {
+		sd_props_load_file(file);
+	}
+	root = getenv("ANDROID_ROOT");
+	if (root && *root) {
+		snprintf(path, sizeof(path), "%s/build.prop", root);
+		sd_props_load_file(path);
+	}
+
+	/* 关键默认值：设备上通常没有 /system/build.prop，没有这些值框架层起不来 */
+	sd_prop_default("ro.build.version.sdk", "23");
+	sd_prop_default("ro.build.version.preview_sdk", "0");
+	sd_prop_default("ro.build.version.release", "6.0.1");
+	sd_prop_default("ro.build.version.codename", "REL");
+	sd_prop_default("ro.build.version.all_codenames", "REL");
+	sd_prop_default("ro.build.version.incremental", "0");
+	sd_prop_default("ro.build.version.security_patch", "2016-01-01");
+	sd_prop_default("ro.build.id", "MMB29M");
+	sd_prop_default("ro.build.type", "user");
+	sd_prop_default("ro.build.tags", "release-keys");
+	sd_prop_default("ro.build.user", "saidroid");
+	sd_prop_default("ro.build.host", "saidroid");
+	sd_prop_default("ro.build.product", "bonito");
+	sd_prop_default("ro.build.flavor", "full_bonito-user");
+	sd_prop_default("ro.build.date.utc", "1450000000");
+	sd_prop_default("ro.build.fingerprint",
+	                "google/bonito/bonito:6.0.1/MMB29M/0:user/release-keys");
+
+	sd_prop_default("ro.product.brand", "google");
+	sd_prop_default("ro.product.manufacturer", "Google");
+	sd_prop_default("ro.product.model", "Pixel 3a XL");
+	sd_prop_default("ro.product.name", "bonito");
+	sd_prop_default("ro.product.device", "bonito");
+	sd_prop_default("ro.product.board", "bonito");
+	sd_prop_default("ro.hardware", "bonito");
+	sd_prop_default("ro.board.platform", "sdm670");
+
+	/* 当前兼容层只支持 arm64，这里如实声明，不要虚报 32 位能力 */
+	sd_prop_default("ro.product.cpu.abi", "arm64-v8a");
+	sd_prop_default("ro.product.cpu.abi2", "");
+	sd_prop_default("ro.product.cpu.abilist", "arm64-v8a");
+	sd_prop_default("ro.product.cpu.abilist32", "");
+	sd_prop_default("ro.product.cpu.abilist64", "arm64-v8a");
+
+	sd_prop_default("ro.secure", "1");
+	sd_prop_default("ro.debuggable", "0");
+	sd_prop_default("ro.zygote", "zygote64");
+	sd_prop_default("ro.kernel.qemu", "0");
+	sd_prop_default("ro.sf.lcd_density", "420");
+	sd_prop_default("ro.opengles.version", "196610");
+	sd_prop_default("persist.sys.timezone", "UTC");
+	sd_prop_default("persist.sys.language", "zh");
+	sd_prop_default("persist.sys.country", "CN");
+	sd_prop_default("dalvik.vm.heapsize", "256m");
+	sd_prop_default("sys.boot_completed", "1");
+}
+
+/* ---------------- 对外接口 ---------------- */
+
+static int sd_prop_get(const char *name, char *value)
+{
+	struct sd_prop *p;
+
+	sd_props_init();
+	p = sd_prop_entry(name);
+	if (!p) {
+		if (value) {
+			*value = 0;
+		}
+		return 0;
+	}
+	if (value) {
+		memcpy(value, p->value, strlen(p->value) + 1);
+	}
+	return (int)strlen(p->value);
+}
+
+static const struct prop_info *sd_prop_find(const char *name)
+{
+	struct sd_prop *p;
+	sd_props_init();
+	p = sd_prop_entry(name);
+	return p ? &p->info : NULL;
+}
+
+static int sd_prop_read(const struct prop_info *pi, char *name, char *value)
+{
+	if (!pi) {
+		if (name) *name = 0;
+		if (value) *value = 0;
+		return 0;
+	}
+	if (name && pi->name) {
+		memcpy(name, pi->name, strlen(pi->name) + 1);
+	}
+	if (value && pi->value) {
+		memcpy(value, pi->value, strlen(pi->value) + 1);
+		return (int)strlen(pi->value);
+	}
+	return 0;
+}
+
+static int sd_prop_foreach(void (*fn)(const struct prop_info *, void *), void *cookie)
+{
+	int b;
+	sd_props_init();
+	if (!fn) {
+		return 0;
+	}
+	for (b = 0; b < SD_PROP_BUCKETS; ++b) {
+		struct sd_prop *p = sd_props[b];
+		while (p) {
+			struct sd_prop *next = p->next;
+			fn(&p->info, cookie);
+			p = next;
+		}
+	}
+	return 0;
+}
+
+static unsigned sd_prop_serial(const struct prop_info *pi)
+{
+	return pi ? pi->serial : 0;
+}
+
+static int sd_prop_set(const char *name, const char *value)
+{
+	sd_props_init();
+	return sd_prop_put(name, value) == 0 ? 0 : -1;
+}
+
+int __system_property_get(const char *name, char *value) { return sd_prop_get(name, value); }
+int bionic___system_property_get(const char *name, char *value) { return sd_prop_get(name, value); }
+
+const struct prop_info *__system_property_find(const char *name) { return sd_prop_find(name); }
+const struct prop_info *bionic___system_property_find(const char *name) { return sd_prop_find(name); }
+
+int __system_property_read(const struct prop_info *pi, char *name, char *value)
+{ return sd_prop_read(pi, name, value); }
+int bionic___system_property_read(const struct prop_info *pi, char *name, char *value)
+{ return sd_prop_read(pi, name, value); }
+
+int __system_property_foreach(void (*fn)(const struct prop_info *, void *), void *cookie)
+{ return sd_prop_foreach(fn, cookie); }
+int bionic___system_property_foreach(void (*fn)(const struct prop_info *, void *), void *cookie)
+{ return sd_prop_foreach(fn, cookie); }
+
+unsigned __system_property_serial(const struct prop_info *pi) { return sd_prop_serial(pi); }
+unsigned bionic___system_property_serial(const struct prop_info *pi) { return sd_prop_serial(pi); }
+
+unsigned __system_property_area_serial(void) { return sd_props_serial; }
+unsigned bionic___system_property_area_serial(void) { return sd_props_serial; }
+
+int __system_property_set(const char *name, const char *value) { return sd_prop_set(name, value); }
+int bionic___system_property_set(const char *name, const char *value) { return sd_prop_set(name, value); }
+
+int __system_property_add(const char *name, unsigned namelen, const char *value, unsigned vallen)
+{
+	char n[SD_PROP_NAME_MAX];
+	char v[SD_PROP_VALUE_MAX];
+	unsigned nc = namelen < sizeof(n) - 1 ? namelen : (unsigned)sizeof(n) - 1;
+	unsigned vc = vallen < sizeof(v) - 1 ? vallen : (unsigned)sizeof(v) - 1;
+	if (!name) {
+		return -1;
+	}
+	memcpy(n, name, nc);
+	n[nc] = 0;
+	if (value) {
+		memcpy(v, value, vc);
+	}
+	v[vc] = 0;
+	return sd_prop_set(n, value ? v : "");
+}
+int bionic___system_property_add(const char *name, unsigned namelen, const char *value, unsigned vallen)
+{ return __system_property_add(name, namelen, value, vallen); }
+
+int __system_property_update(struct prop_info *pi, const char *value, unsigned len)
+{
+	char v[SD_PROP_VALUE_MAX];
+	unsigned c = len < sizeof(v) - 1 ? len : (unsigned)sizeof(v) - 1;
+	if (!pi || !pi->name) {
+		return -1;
+	}
+	if (value) {
+		memcpy(v, value, c);
+	}
+	v[c] = 0;
+	return sd_prop_set(pi->name, value ? v : "");
+}
+int bionic___system_property_update(struct prop_info *pi, const char *value, unsigned len)
+{ return __system_property_update(pi, value, len); }
+
+int __system_property_wait(const struct prop_info *pi, unsigned old_serial,
+                           unsigned *new_serial, const struct timespec *timeout)
+{
+	(void)timeout;
+	sd_props_init();
+	if (new_serial) {
+		*new_serial = pi ? pi->serial : sd_props_serial;
+	}
+	return (pi && pi->serial != old_serial) ? 1 : 0;
+}
+int bionic___system_property_wait(const struct prop_info *pi, unsigned old_serial,
+                                  unsigned *new_serial, const struct timespec *timeout)
+{ return __system_property_wait(pi, old_serial, new_serial, timeout); }
