+/* Called under the recursive dl lock. Build first, so limits never leave a
+ * partially replaced search path while another app thread loads a dependency. */
+int dl_append_library_path(const char *path)
+{
+	char merged[LDPATH_BUFSIZE] = {0};
+	const char *entries[LDPATH_MAX];
+	char *incoming = strdup(path ? path : "");
+	if (!incoming) return -1;
+	size_t length = 0;
+	int count = 0;
+	for (int i = 0; apkenv_ldpaths[i] && count < LDPATH_MAX; i++) {
+		entries[count++] = apkenv_ldpaths[i];
+	}
+	char *save = NULL;
+	for (char *entry = strtok_r(incoming, ":", &save); entry; entry = strtok_r(NULL, ":", &save)) {
+		int duplicate = 0;
+		for (int i = 0; i < count; i++) if (!strcmp(entries[i], entry)) { duplicate = 1; break; }
+		if (duplicate) continue;
+		if (count == LDPATH_MAX) { free(incoming); errno = ENAMETOOLONG; return -1; }
+		entries[count++] = entry;
+	}
+	for (int i = 0; i < count; i++) {
+		size_t size = strlen(entries[i]);
+		if (length + size + (length ? 1 : 0) >= sizeof(merged)) { free(incoming); errno = ENAMETOOLONG; return -1; }
+		if (length) merged[length++] = ':';
+		memcpy(merged + length, entries[i], size); length += size;
+	}
+	dl_parse_library_path(merged, ":");
+	free(incoming);
+	return 0;
+}
