+/* ---- 分配追踪（SD_ALLOC_TRACE=1 开启）：在 bionic 世界的唯一入口处校验 ---- */
+#define SD_TAB_BITS 20
+#define SD_TAB_SIZE (1u << SD_TAB_BITS)
+static void *sd_tab[SD_TAB_SIZE];
+static int sd_trace_state = -1;
+static int sd_trace_on(void) {
+	if (sd_trace_state < 0) {
+		const char *e = getenv("SD_ALLOC_TRACE");
+		sd_trace_state = (e && *e == '1') ? 1 : 0;
+	}
+	return sd_trace_state;
+}
+static size_t sd_hash(void *p) {
+	uintptr_t x = (uintptr_t)p;
+	x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 33;
+	return (size_t)(x & (SD_TAB_SIZE - 1));
+}
+static void sd_tab_add(void *p) {
+	if (!p) return;
+	size_t i = sd_hash(p);
+	for (size_t k = 0; k < 64; ++k) {
+		size_t j = (i + k) & (SD_TAB_SIZE - 1);
+		if (!sd_tab[j]) { sd_tab[j] = p; return; }
+	}
+}
+static int sd_tab_del(void *p) {
+	size_t i = sd_hash(p);
+	for (size_t k = 0; k < 64; ++k) {
+		size_t j = (i + k) & (SD_TAB_SIZE - 1);
+		if (sd_tab[j] == p) { sd_tab[j] = NULL; return 1; }
+		if (!sd_tab[j]) return 0;
+	}
+	return 0;
+}
