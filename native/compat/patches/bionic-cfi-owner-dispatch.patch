 static ElfW(Sym) * apkenv__elf_lookup(soinfo *si, struct symbol_name *symbol_name)
 {
 	return is_gnu_hash(si) ? apkenv__elf_lookup_gnu(si, symbol_name) : apkenv__elf_lookup_sysv(si, symbol_name);
+}
+
+
+/* Caller holds the recursive dl lock, so owner/checker cannot disappear during
+ * dispatch. No address cache or extra reference pins an unloadable DSO. */
+static bool apkenv_cfi_mapped(const soinfo *si, ElfW(Addr) address, bool executable)
+{
+	ElfW(Addr) relative = address - si->base;
+	for (int i = 0; i < si->phnum; i++) {
+		const ElfW(Phdr) *p = &si->phdr[i];
+		if (p->p_type == PT_LOAD && relative >= p->p_vaddr &&
+		    relative - p->p_vaddr < p->p_memsz &&
+		    (!executable || (p->p_flags & PF_X)))
+			return true;
+	}
+	return false;
+}
+
+int apkenv_cfi_check_locked(uint64_t type, void *target, void *diagnostic)
+{
+	soinfo *si = apkenv_find_containing_library(target);
+	if (!si) return 0; /* Host/glibc mapping uses its own dispatcher. */
+	if (!(si->flags & FLAG_LINKED) || (si->flags & FLAG_ERROR) ||
+	    !si->phdr || !apkenv_cfi_mapped(si, (ElfW(Addr))target, false))
+		return -1;
+	/* Cross-DSO virtual-call checks can target read-only vtable data, so
+	 * validate a real PT_LOAD range rather than requiring executable data. */
+	struct symbol_name name = { .name = "__cfi_check" };
+	ElfW(Sym) *symbol = apkenv__elf_lookup(si, &name);
+	if (!symbol) return 1; /* This owner is genuinely not CFI-instrumented. */
+	ElfW(Addr) checker = si->base + symbol->st_value;
+	if (ELF_ST_TYPE(symbol->st_info) != STT_FUNC ||
+	    !apkenv_cfi_mapped(si, checker, true))
+		return -1;
+	((void (*)(uint64_t, void *, void *))checker)(type, target, diagnostic);
+	return 1;
 }
 
