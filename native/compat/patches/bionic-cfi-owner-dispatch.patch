+/* Explicit private-loader API: check against the current owner under the
+ * same lock used for dlopen/dlclose, without symbolizing every target. */
+int bionic_cfi_check(uint64_t type, void *target, void *diagnostic)
+{
+	pthread_mutex_lock(&apkenv_dl_lock);
+	int result = apkenv_cfi_check_locked(type, target, diagnostic);
+	pthread_mutex_unlock(&apkenv_dl_lock);
+	return result;
+}
