--- a/linker/linker.c
+++ b/linker/linker.c
@@ -1720,6 +1720,20 @@
 			DL_ERR("OOPS: %5d recursive link to '%s'", apkenv_pid, si->name);
 			return NULL;
 		}
+	}
+
+	/* RTLD_NOLOAD is a query, including for ELF files that exist on disk.
+	 * A preload guard must not run constructors or make a JNI library appear
+	 * loaded before ART has performed its real load/JNI_OnLoad transaction. */
+	if (glibc_flag & RTLD_NOLOAD) {
+		if (try_glibc && glibc_handle) {
+			int flags = glibc_flag;
+			if (!(flags & (RTLD_LAZY | RTLD_NOW))) flags |= RTLD_NOW;
+			*glibc_handle = dlopen(name, flags);
+			if (*glibc_handle) return NULL;
+		}
+		DL_ERR("Library '%s' is not loaded", name);
+		return NULL;
 	}
 
 	TRACE("[ %5d '%s' has not been loaded yet.  Locating...]\n", apkenv_pid, name);
